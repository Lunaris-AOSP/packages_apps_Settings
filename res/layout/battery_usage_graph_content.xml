<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/battery_graph_tabs_background"
        android:padding="@dimen/settingslib_expressive_space_extrasmall2"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/battery_graph_day"
            style="@style/BatteryGraphTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/battery_graph_last_day" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/battery_graph_week"
            style="@style/BatteryGraphTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/battery_graph_last_week" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/battery_graph_card_top"
        android:padding="@dimen/settingslib_expressive_space_small1"
        android:orientation="vertical">
        <TextView
            style="@style/BatteryGraphHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/battery_graph_screen_usage" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/battery_graph_metric_start"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    style="@style/BatteryGraphText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_graph_screen_on" />
                <TextView
                    android:id="@+id/battery_graph_screen_on_time"
                    style="@style/BatteryGraphValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/battery_graph_unavailable" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:background="@drawable/battery_graph_metric_end"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    style="@style/BatteryGraphText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_graph_screen_off" />
                <TextView
                    android:id="@+id/battery_graph_screen_off_time"
                    style="@style/BatteryGraphValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/battery_graph_off_text"
                    android:text="@string/battery_graph_unavailable" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/battery_graph_card_middle"
        android:padding="@dimen/settingslib_expressive_space_small1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/battery_graph_usage_details"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/battery_graph_usage_info"
                    style="@style/BatteryGraphText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="24dp"
                    android:gravity="center_vertical"
                    android:paddingEnd="8dp"
                    android:drawableEnd="@drawable/ic_info"
                    android:drawablePadding="5dp"
                    android:drawableTint="@color/battery_graph_secondary"
                    android:text="@string/battery_graph_since_reset" />
                <TextView
                    android:id="@+id/battery_graph_used_time"
                    style="@style/BatteryGraphHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="26sp"
                    android:text="@string/battery_graph_unavailable" />
            </LinearLayout>
            <TextView
                android:id="@+id/battery_graph_charging_legend"
                style="@style/BatteryGraphText"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="5dp"
                android:drawablePadding="6dp"
                android:textSize="11sp"
                android:text="@string/battery_graph_charging_hours" />
        </LinearLayout>
        <com.android.settings.fuelgauge.batteryusage.BatteryUsageBarChart
            android:id="@+id/battery_graph_level_chart"
            android:layout_width="match_parent"
            android:layout_height="156dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/hourly_battery_usage_chart"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/battery_graph_card_bottom"
        android:padding="@dimen/settingslib_expressive_space_small1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/battery_graph_screen_time_title"
                style="@style/BatteryGraphHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/battery_graph_hourly_screen_time" />
            <TextView
                android:id="@+id/battery_graph_on_legend"
                style="@style/BatteryGraphText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:drawablePadding="4dp"
                android:text="@string/battery_graph_legend_on" />
            <TextView
                android:id="@+id/battery_graph_off_legend"
                style="@style/BatteryGraphText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:drawablePadding="4dp"
                android:text="@string/battery_graph_legend_off" />
        </LinearLayout>
        <com.android.settings.fuelgauge.batteryusage.BatteryUsageBarChart
            android:id="@+id/battery_graph_activity_chart"
            android:layout_width="match_parent"
            android:layout_height="156dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/battery_graph_hourly_screen_time"
            android:focusable="true" />
        <TextView
            android:id="@+id/battery_graph_status"
            style="@style/BatteryGraphText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:gravity="center"
            android:accessibilityLiveRegion="polite"
            android:text="@string/battery_graph_loading" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/battery_graph_reset"
        style="@style/SettingsLibButtonStyle.Expressive.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:minHeight="48dp"
        android:text="@string/battery_graph_reset"
        android:visibility="gone" />
</merge>
